{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simstim",
  "mainBinaryName": "simstim",
  "version": "0.1.0",
  "identifier": "com.simstim.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Simstim",
        "width": 1024,
        "height": 600,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 30
        },
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "14.2"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../LICENSE": "licenses/simstim-MIT.txt",
      "../../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../src/assets/fonts/SourceSerif4-OFL.txt": "licenses/SourceSerif4-OFL.txt",
      "../src/assets/fonts/SplineSansMono-OFL.txt": "licenses/SplineSansMono-OFL.txt"
    }
  }
}
